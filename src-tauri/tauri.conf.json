{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Astryx",
    "identifier": "tools.astryx.astryx",
    "build": {
        "devUrl": "http://localhost:1420",
        "frontendDist": "../src"
    },
    "app": {
        "windows": [
            {
                "title": "Astryx",
                "width": 1400,
                "height": 900,
                "minWidth": 1200,
                "minHeight": 800,
                "center": true,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        },
        "withGlobalTauri": true
    },
    "bundle": {
        "active": true,
        "targets": ["deb", "rpm", "appimage", "nsis", "app", "dmg"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "category": "Utility",
        "shortDescription": "Astrophotography planning and imaging session analysis",
        "longDescription": "Astryx helps astrophotographers plan imaging sessions and analyze their results. Search and filter a database of 14,000+ deep-sky objects, plan sessions around visibility and moon conditions, sequence targets for the night, and analyze ASIAir and PHD2 imaging and guiding logs to see what actually happened at the telescope.",
        "homepage": "https://astryx.tools",
        "linux": {
            "deb": {
                "section": "science"
            }
        }
    }
}
